import pybamm
import numpy as np
import pandas as pd

def simulate_spm(
    current_A,
    capacity_Ah,
    t_end,
    n_points=200,
    param_overrides=None
):
    model = pybamm.lithium_ion.SPM()

    param = pybamm.ParameterValues("Chen2020")

    if param_overrides:
        for k, v in param_overrides.items():
            param[k] = v

    param["Nominal cell capacity [A.h]"] = capacity_Ah
    param["Current function [A]"] = current_A

    sim = pybamm.Simulation(
        model,
        parameter_values=param,
        solver=pybamm.CasadiSolver(mode="fast"),
    )

    t_eval = np.linspace(0, t_end, n_points)
    sim.solve(t_eval)

    sol = sim.solution

    return {
        "time": t_eval,
        "Voltage": sol["Terminal voltage [V]"].entries,
        "SoC": sol["State of Charge"].entries,
        "cs_n": sol["X-averaged negative particle concentration"].entries,
        "cs_p": sol["X-averaged positive particle concentration"].entries,
    }


